{
  "name": "airbnb-ui-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=America/Los_Angeles node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write app components lib types tests playwright.config.ts next.config.ts",
    "format:check": "prettier --check app components lib types tests playwright.config.ts next.config.ts"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
